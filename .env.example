# Cloudflare R2 credentials
# Copy this file to .env and fill in real values.
# .env is in .gitignore — NEVER commit the real .env.

# Your Cloudflare account ID (32-char hex, shown in R2 dashboard URL)
R2_ACCOUNT_ID=your_account_id_here

# R2 API token — generate at R2 → Manage R2 API Tokens
# Grant "Object Read & Write" scoped to your bucket
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# The R2 bucket name you created (e.g. miso-lmp)
R2_BUCKET_NAME=your_bucket_name_here
